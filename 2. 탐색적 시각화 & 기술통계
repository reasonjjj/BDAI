#기술통계(평균, 표준편차, 중앙값, 최빈값, 산포도)
def describe_full(series, name):
    print(f'\n--- {name} 기술통계 ---')
    print(f'평균     : {series.mean():.2f}')
    print(f'중앙값   : {series.median():.2f}')
    print(f'최빈값   : {series.mode().iloc[0]:.2f}')
    print(f'표준편차 : {series.std():.2f}')
    print(f'분산     : {series.var():.2f}')
    print(f'최소~최대: {series.min():.2f} ~ {series.max():.2f}')
    print(f'IQR      : {series.quantile(0.75) - series.quantile(0.25):.2f}')

describe_full(sess['duration_sec'], '세션 체류시간(초)')
describe_full(sess['event_count'], '세션 내 이벤트 수')
describe_full(app_merged['days_to_apply'], '신청 소요일수')

#변동계수(CV), 왜도, 첨도
def dist_shape(series, name):
    cv = series.std() / series.mean() * 100  # 변동계수(%)
    skew = series.skew()
    kurt = series.kurt()
    print(f'\n--- {name} 분포 형태 ---')
    print(f'변동계수(CV) : {cv:.2f}%  (값이 클수록 상대적 산포가 큼)')
    print(f'왜도(Skewness): {skew:.2f}  ({"오른쪽 꼬리(양의 왜도)" if skew>0 else "왼쪽 꼬리(음의 왜도)" if skew<0 else "대칭"})')
    print(f'첨도(Kurtosis): {kurt:.2f}  ({"정규분포보다 뾰족/이상치 많음" if kurt>0 else "정규분포보다 평평함"})')

dist_shape(sess['duration_sec'], '세션 체류시간(초)')
dist_shape(sess['event_count'], '세션 내 이벤트 수')
dist_shape(app_merged['days_to_apply'], '신청 소요일수')

