from sklearn.model_selection import train_test_split

# 더미변수 생성 (device, medium_grp)
X = pd.get_dummies(user_beh[['device', 'medium_grp']], drop_first=True)
X['duration_sec'] = user_beh['duration_sec']
X['event_count']  = user_beh['event_count']
y = user_beh['applied']

print('특징변수:', X.columns.tolist())
print('전체 클래스 비율:\n', y.value_counts(normalize=True).round(3))

# stratify=y : 신청/미신청 비율(약 65:35)을 train/test에 동일하게 유지
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42, stratify=y
)

print('\nTrain 크기:', X_train.shape, ' Test 크기:', X_test.shape)
print('Train 클래스비율:', y_train.value_counts(normalize=True).round(3).to_dict())
print('Test 클래스비율 :', y_test.value_counts(normalize=True).round(3).to_dict())

#의사결정나무 depth 탐색 (과적합 확인)
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import roc_auc_score

print('depth별 Train/Test AUC (Train-Test Gap으로 과적합 판단)')
for depth in [2, 3, 4, 5, 6, None]:
    dt = DecisionTreeClassifier(max_depth=depth, random_state=42)
    dt.fit(X_train, y_train)
    train_auc = roc_auc_score(y_train, dt.predict_proba(X_train)[:, 1])
    test_auc  = roc_auc_score(y_test,  dt.predict_proba(X_test)[:, 1])
    gap = train_auc - test_auc
    print(f'depth={str(depth):>4} : train_auc={train_auc:.3f}, test_auc={test_auc:.3f}, gap={gap:.3f}')

최적트리 + 랜덤 포레스트 + 로지스틱 회귀
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression

dt_best = DecisionTreeClassifier(max_depth=3, random_state=42).fit(X_train, y_train)
rf = RandomForestClassifier(n_estimators=200, max_depth=5, random_state=42).fit(X_train, y_train)
lr = LogisticRegression(max_iter=1000).fit(X_train, y_train)

results = pd.DataFrame({
    '모델': ['DecisionTree(depth=3)', 'RandomForest', 'LogisticRegression'],
    'Test AUC': [
        roc_auc_score(y_test, dt_best.predict_proba(X_test)[:,1]),
        roc_auc_score(y_test, rf.predict_proba(X_test)[:,1]),
        roc_auc_score(y_test, lr.predict_proba(X_test)[:,1]),
    ]
})
print(results.round(3))

K-Fold 교차검증 (CV-AUC)
from sklearn.model_selection import StratifiedKFold, cross_val_score

skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

for name, model in [('DecisionTree', dt_best), ('RandomForest', rf), ('LogisticRegression', lr)]:
    cv_scores = cross_val_score(model, X, y, cv=skf, scoring='roc_auc')
    print(f'{name:20s} CV AUC = {cv_scores.mean():.3f} (+/- {cv_scores.std():.3f})')

#변수 중요도 (랜덤 포레스트, 지니 불순도 기반)
importance = pd.Series(rf.feature_importances_, index=X.columns).sort_values(ascending=False)
print('=== 변수 중요도 (지니 불순도 감소량 기준) ===')
print(importance.round(3))

plt.figure(figsize=(7,4))
importance.plot(kind='barh', color='teal')
plt.title('신청 전환 예측 - 변수 중요도')
plt.gca().invert_yaxis()
plt.tight_layout()
plt.show()

#임계값(Threshold)별 정밀도, 재현율, 혼동행렬
from sklearn.metrics import precision_score, recall_score, confusion_matrix

probs = rf.predict_proba(X_test)[:, 1]

print('임계값별 Precision/Recall')
for th in [0.3, 0.4, 0.5, 0.6, 0.7]:
    pred = (probs >= th).astype(int)
    print(f'threshold={th} : precision={precision_score(y_test, pred):.3f}, recall={recall_score(y_test, pred):.3f}')

pred_default = (probs >= 0.5).astype(int)
print('\n혼동행렬 (threshold=0.5)')
print(confusion_matrix(y_test, pred_default))
print('(행: 실제 0/1,  열: 예측 0/1)')
