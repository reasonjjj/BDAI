# 결측치 확인
def missing_report(df, name) :
  m = df.isnull().sum()
  pct = (m/len(df)*100).round(2)
  rep = pd.DataFrame({'결측치수': m, '결측치비율(%)' : pct})
  rep = rep[rep['결측치수']>0]
  print(f'\n--- {name} 결측치 현황 ---')
  if len(rep) == 0:
    print('결측치 없음')
  else:
      print(rep)

missing_report(info, 'event_info')
missing_report(app,  'event_application')
missing_report(beh,  'event_behavior')

print('\nmasked_user_id 결측 건의 event_name 분포:')
