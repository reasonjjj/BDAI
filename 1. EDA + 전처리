# 빈도분석
def freq_table(series, name):
  cnt = series.value_counts()
  pct = (series.value_counts(normalize=True)*100).round(2)
  tbl = pd.DataFrame({'빈도':cnt, '비율(%)':pct})
  print(f'\n--- {name} 빈도분석 ---')
  print(tbl)

print('####### event_info #######')
freq_table(info['event_category'], 'event_category (행사유형)')
freq_table(info['event_format'],   'event_format(진행방식)')

print('\n####### event_application #######')
